generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("NEON_DATABASE_URL")
  directUrl = env("NEON_DATABASE_URL_UNPOOLED")
}

// ------------------------------------------------------------
// Tenant
// ------------------------------------------------------------

model School {
  id        String   @id @default(cuid())
  name      String
  boardType String   // "CBSE" | "ICSE" | "STATE" | etc. — drives grading config
  address           String?
  phone             String?
  email             String?  // School official contact email
  website           String?
  logoUrl           String?
  principalName     String?
  affiliationNumber String?  // e.g. CBSE/board affiliation number
  establishedYear   Int?
  trustName         String?  // Optional society / trust banner (e.g. "के. बापूराव पाटील...")
  term1StartDate    DateTime?
  term1EndDate      DateTime?
  term2StartDate    DateTime?
  term2EndDate      DateTime?
  isActive          Boolean  @default(true)
  status            String   @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED" | "SUSPENDED"
  suspendedReason   String?
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt         DateTime @default(now())

  users        User[]
  students     Student[]
  parents      Parent[]
  classes      Class[]
  sections     Section[]
  subjects     Subject[]
  feeStructures FeeStructure[]
  invoices     FeeInvoice[]
  payments     Payment[]
  notices      Notice[]
  attendance   Attendance[]
  reportCards  ReportCard[]
  gradingScale GradingScale[]
  examSlots    ExamSlot[]
  periods      Period[]
  timetableSlots TimetableSlot[]
  syllabusTopics SyllabusTopic[]
  certificateLogs CertificateLog[]
  departments  Department[]
  leaveRequests LeaveRequest[]
  assignments  Assignment[]
  subscription Subscription?
  parentLinkRequests ParentStudentLinkRequest[]
  notifications Notification[]
  documents    Document[]

  @@index([isActive])
}

// ------------------------------------------------------------
// Users & Auth
// ------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  ACCOUNTANT
  PRINCIPAL
}

model User {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  email     String   @unique
  phone     String?
  passwordHash String?      // if not using an external auth provider
  role      Role
  isActive  Boolean  @default(true)
  status    String   @default("ACTIVE") // "ACTIVE" | "PENDING_VERIFICATION" | "PENDING_APPROVAL" | "SUSPENDED" | "DEACTIVATED"
  emailVerified DateTime?
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?   // Base32 TOTP secret
  mfaRecoveryCodes String[]  @default([])
  createdAt DateTime @default(now())

  // Optional links depending on role
  teacherProfile Teacher?
  parentProfiles Parent[]
  certificatesIssued CertificateLog[]
  leaveRequests LeaveRequest[] @relation("StaffLeaveRequests")
  leavesApproved LeaveRequest[] @relation("LeaveApprover")
  usedTotpTokens UsedTotpToken[]
  notifications Notification[]

  @@index([schoolId, role])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  departmentId String?
  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHOD")
  subjects  TeacherSubject[]
  sections  Section[] @relation("ClassTeacher")
  timetableSlots TimetableSlot[]
  assignments Assignment[]

  @@index([departmentId])
}

// ------------------------------------------------------------
// Academic structure
// ------------------------------------------------------------

model Class {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  name     String   // "Class 1", "Grade 10"
  order    Int      // for sorting / promotion logic

  sections Section[]
  syllabusTopics SyllabusTopic[]

  @@unique([schoolId, name])
}

model Section {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  name          String   // "A", "B"
  classTeacherId String?
  classTeacher  Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  academicYear  String   // "2026-27" — critical for year rollover, see note below

  students   Student[]
  attendance Attendance[]
  timetableSlots TimetableSlot[]
  assignments Assignment[]

  @@unique([schoolId, classId, name, academicYear])
}

model Subject {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  name     String

  teachers TeacherSubject[]
  marks    Marks[]
  timetableSlots TimetableSlot[]
  syllabusTopics SyllabusTopic[]
  assignments Assignment[]

  @@unique([schoolId, name])
}

model TeacherSubject {
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

// ------------------------------------------------------------
// Students & Parents (many-to-many: siblings, guardians)
// ------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  admissionNo   String
  rollNumber    String?  // Sequential/manual roll number e.g. "53", "01", "A-12"
  fullName      String
  dob           DateTime
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id])
  academicYear  String
  isActive      Boolean  @default(true) // false = withdrawn/graduated, don't hard-delete
  photoUrl      String?
  classDesignation String? // e.g. "Class Monitor", "Sports Captain", "Prefect"
  parentEmail      String? // Primary parent contact email for self-registration auto-linking

  // Admission details (optional informational fields)
  gender                    String?
  bloodGroup                String?
  // Sensitive PII: stored as plain text for MVP; future hardening: encryption at rest, restricted display
  aadharNumber              String?
  category                  String?
  currentAddress            String?
  permanentAddress          String?
  previousSchoolName        String?
  previousClass             String?
  transferCertificateNumber String?
  fatherName                String?
  fatherOccupation          String?
  fatherPhone               String?
  motherName                String?
  motherOccupation          String?
  motherPhone               String?
  guardianName              String?
  guardianRelation          String?
  guardianPhone             String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  medicalConditions         String?
  archivedAt                DateTime?
  archivedReason            String?   // "GRADUATED" | "WITHDRAWN" | "TRANSFERRED" | "OTHER"
  archivedByUserId          String?

  parents       StudentParent[]
  attendance    Attendance[]
  marks         Marks[]
  invoices      FeeInvoice[]
  reportCards   ReportCard[]
  certificateLogs CertificateLog[]
  parentLinkRequests ParentStudentLinkRequest[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, sectionId])
}

model Parent {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  fullName String
  email    String?
  phone    String

  students StudentParent[]
  linkRequests ParentStudentLinkRequest[]

  @@unique([schoolId, email])
  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([email])
  @@index([userId])
}

// Explicit join table — handles multiple guardians per student
// and multiple children per parent (siblings) cleanly.
model StudentParent {
  studentId    String
  student      Student @relation(fields: [studentId], references: [id])
  parentId     String
  parent       Parent  @relation(fields: [parentId], references: [id])
  relationship String  // "Father" | "Mother" | "Guardian"
  isPrimary    Boolean @default(false) // who gets billed / primary contact

  @@id([studentId, parentId])
  @@index([parentId])
}

// ------------------------------------------------------------
// Attendance
// ------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

model Attendance {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  date      DateTime @db.Date
  status    AttendanceStatus
  markedBy  String   // userId of teacher

  // One attendance record per student per day — prevents double-marking
  @@unique([studentId, date])
  @@index([schoolId, sectionId, date])
}

// ------------------------------------------------------------
// Fees & Payments
// ------------------------------------------------------------

model FeeStructure {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   // "Tuition Fee - Class 5 - 2026-27"
  academicYear String
  amount       Decimal  @db.Decimal(10, 2)
  frequency    String   // "MONTHLY" | "QUARTERLY" | "ANNUAL" | "ONE_TIME"

  invoices FeeInvoice[]

  @@index([schoolId])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

model FeeInvoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure  @relation(fields: [feeStructureId], references: [id])
  amountDue      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  dueDate        DateTime
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime      @default(now())

  payments Payment[]

  @@index([schoolId, studentId, status])
  @@index([feeStructureId])
}

model Payment {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  invoiceId      String
  invoice        FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount         Decimal  @db.Decimal(10, 2)
  method         String   // "CASH" | "UPI" | "CARD" | "BANK_TRANSFER"
  gatewayRef     String?  // Razorpay payment_id — for webhook reconciliation
  receiptNumber  String   // human-readable, sequential per school
  paidAt         DateTime @default(now())

  @@unique([schoolId, receiptNumber])
  @@index([gatewayRef])
  @@index([invoiceId])
}

// ------------------------------------------------------------
// Exams, Marks & Report Cards
// ------------------------------------------------------------

model GradingScale {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  minScore Int
  maxScore Int
  grade    String  // "A+", "B", etc — configurable per school/board, don't hardcode
}

model ExamSlot {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  academicYear String   // "2026-27"
  term         String   // "TERM1" | "TERM2"
  code         String   // "UT1", "UT2", "TERM1", "UT3", "UT4", "TERM2"
  name         String   // "UT 1", "UT 2", "Term 1 Exam", etc.
  maxScore     Decimal  @db.Decimal(5, 2)
  order        Int
  createdAt    DateTime @default(now())

  @@unique([schoolId, academicYear, code])
  @@index([schoolId, academicYear])
}

model Marks {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  examName   String   // "UT1", "UT2", "TERM1", "UT3", "UT4", "TERM2"
  score      Decimal  @db.Decimal(5, 2)
  maxScore   Decimal  @db.Decimal(5, 2)

  @@unique([studentId, subjectId, examName])
}

model ReportCard {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  academicYear String
  term         String   // "TERM1" | "TERM2" | "ANNUAL"
  remarks      String?  // Optional personalized teacher/principal remark
  pdfUrl       String?  // generated PDF stored in S3/R2
  generatedAt  DateTime @default(now())

  @@unique([studentId, academicYear, term])
}

// ------------------------------------------------------------
// Notices
// ------------------------------------------------------------

model Notice {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  title     String
  body      String
  audience  Role[]   // which roles see this notice
  createdAt DateTime @default(now())

  @@index([schoolId])
}

// ------------------------------------------------------------
// Timetable — Period (bell schedule) & TimetableSlot (assignments)
// ------------------------------------------------------------

model Period {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  periodNumber Int
  label        String   // "Period 1", "Lunch", "Recess"
  startTime    String   // "09:00" — stored as HH:mm string
  endTime      String   // "09:45"
  isBreak      Boolean  @default(false)

  timetableSlots TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
}

model TimetableSlot {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  dayOfWeek    String   // "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT"
  periodId     String
  period       Period   @relation(fields: [periodId], references: [id])
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id])
  academicYear String

  @@unique([sectionId, dayOfWeek, periodId, academicYear])
  @@index([schoolId, sectionId])
  @@index([teacherId])
}

// ------------------------------------------------------------
// Syllabus Tracking
// ------------------------------------------------------------

model SyllabusTopic {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id])
  classId       String
  class         Class     @relation(fields: [classId], references: [id])
  academicYear  String
  topicTitle    String
  description   String?
  order         Int
  isCompleted   Boolean   @default(false)
  completedDate DateTime?

  @@index([schoolId, classId, subjectId, academicYear])
}

// ------------------------------------------------------------
// Certificate Log — TC persistence only
// (Bonafide / Character certs are ephemeral, generated on-demand)
// ------------------------------------------------------------

model CertificateLog {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  tcNumber          String   // school-assigned TC serial, e.g. "TC-2026-001"
  issueDate         DateTime
  reasonForLeaving  String
  lastAttendanceDate DateTime
  conductRemark     String
  generatedByUserId String
  generatedByUser   User     @relation(fields: [generatedByUserId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([schoolId, tcNumber])
  @@index([schoolId, studentId])
}

// ------------------------------------------------------------
// Departments
// ------------------------------------------------------------

model Department {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  name               String
  headOfDepartmentId String?  @unique
  headOfDepartment   Teacher? @relation("DepartmentHOD", fields: [headOfDepartmentId], references: [id])
  teachers           Teacher[] @relation("DepartmentMembers")
  createdAt          DateTime @default(now())

  @@unique([schoolId, name])
}

// ------------------------------------------------------------
// Leave Management (Staff)
// ------------------------------------------------------------

model LeaveRequest {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  userId           String
  user             User     @relation("StaffLeaveRequests", fields: [userId], references: [id])
  leaveType        String   // e.g. "Sick", "Casual", "Earned", "Maternity", "Other"
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  approvedByUserId String?
  approvedByUser   User?    @relation("LeaveApprover", fields: [approvedByUserId], references: [id])
  adminRemark      String?
  createdAt        DateTime @default(now())

  @@index([schoolId, userId])
  @@index([schoolId, status])
}

// ------------------------------------------------------------
// Assignments & Study Notes
// ------------------------------------------------------------

model Assignment {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id])
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id])
  teacherId     String
  teacher       Teacher   @relation(fields: [teacherId], references: [id])
  title         String
  description   String
  dueDate       DateTime?
  attachmentUrl String?
  createdAt     DateTime  @default(now())

  @@index([schoolId, sectionId])
  @@index([schoolId, teacherId])
  @@index([subjectId])
}

// ------------------------------------------------------------
// Platform Administration & Multi-School Governance
// ------------------------------------------------------------

model SchoolRegistrationRequest {
  id              String    @id @default(cuid())
  schoolName      String
  boardType       String    // "CBSE" | "ICSE" | "STATE" | etc.
  officialEmail   String    @unique
  phone           String
  address         String?
  principalName   String
  affiliationNo   String?
  adminEmail      String
  adminName       String
  adminPhone      String?
  adminPasswordHash String? // bcrypt hash stored until Super Admin approves
  documentUrl     String?   // Uploaded affiliation certificate / trust deed document URL
  documentName    String?   // Original uploaded file name
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  rejectionReason String?
  emailVerifiedAt DateTime?
  approvedAt      DateTime?
  approvedByUserId String?
  schoolId        String?   // Linked school ID after Super Admin approval
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([adminEmail])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  type      String    // "SCHOOL_REGISTRATION" | "PARENT_SIGNUP" | "STAFF_INVITATION" | "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime?
  metadata  String?   // Optional JSON payload (e.g. pending roles, temp data)
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?  // null for platform-level operations
  userId     String?  // Actor user ID
  userEmail  String?  // Actor email
  action     String   // e.g. "SCHOOL_REGISTRATION_SUBMITTED", "SCHOOL_APPROVED", "SCHOOL_SUSPENDED", "STAFF_INVITED"
  targetType String   // e.g. "School", "User", "SchoolRegistrationRequest"
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Platform Security & Distributed Authentication Defense
// ------------------------------------------------------------

model UsedTotpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      BigInt   // TOTP 30s counter step
  codeHash  String   // SHA-256 derived identifier of (userId + ":" + step + ":" + code)
  expiresAt DateTime // Window expiration timestamp (e.g. now + 90s)
  createdAt DateTime @default(now())

  @@unique([userId, step])
  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id              String   @id @default(cuid())
  identifier      String   @unique // Normalized login identifier (e.g. "login:user@example.com")
  attempts        Int      @default(1)
  windowExpiresAt DateTime // Expiration timestamp for current rate-limit rolling window
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([identifier])
  @@index([windowExpiresAt])
}

// ------------------------------------------------------------
// SaaS Subscriptions & Tiered Pricing
// ------------------------------------------------------------

model SubscriptionPlan {
  id                   String   @id @default(cuid())
  name                 String   // "Starter", "Professional", "Enterprise"
  code                 String   @unique // "STARTER", "PROFESSIONAL", "ENTERPRISE"
  description          String?
  pricePerStudentMonth Decimal  @db.Decimal(10, 2)
  pricePerStudentYear  Decimal  @db.Decimal(10, 2)
  minStudents          Int      @default(50)
  maxStudents          Int?
  features             String[] @default([])
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String            @id @default(cuid())
  schoolId               String            @unique
  school                 School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId                 String?
  plan                   SubscriptionPlan? @relation(fields: [planId], references: [id])
  status                 String            @default("TRIALING") // "TRIALING" | "ACTIVE" | "PAST_DUE" | "EXPIRED" | "CANCELLED"
  billingCycle           String            @default("ANNUAL") // "MONTHLY" | "ANNUAL"
  studentCount           Int               @default(0)
  amount                 Decimal           @default(0) @db.Decimal(10, 2)
  currency               String            @default("INR")
  trialStartsAt          DateTime          @default(now())
  trialEndsAt            DateTime
  currentPeriodStart     DateTime          @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean           @default(false)
  razorpaySubscriptionId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

// ------------------------------------------------------------
// Parent-Student Link Approval Workflow
// ------------------------------------------------------------

model ParentStudentLinkRequest {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId         String
  parent           Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship     String    @default("GUARDIAN") // "FATHER" | "MOTHER" | "GUARDIAN"
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  rejectionReason  String?
  proofDocumentUrl String?
  requestedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  @@unique([schoolId, parentId, studentId])
  @@index([schoolId, status])
}

// ------------------------------------------------------------
// In-App & Multi-Channel Notifications
// ------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    // "REGISTRATION" | "APPROVAL" | "SUBSCRIPTION" | "PAYMENT" | "ACADEMIC" | "SYSTEM"
  linkUrl   String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([schoolId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Webhook Idempotency & Event Auditing
// ------------------------------------------------------------

model WebhookEvent {
  id           String   @id @default(cuid())
  gateway      String   @default("RAZORPAY")
  eventId      String   @unique
  eventType    String
  payload      String   @db.Text
  status       String   @default("PROCESSED") // "PROCESSED" | "FAILED" | "IGNORED"
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([gateway, eventType])
}

// ------------------------------------------------------------
// Private Document Storage & Retention
// ------------------------------------------------------------

model Document {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title            String
  category         String   // "REGISTRATION", "STUDENT_RECORD", "TC", "RECEIPT", "POLICY", "BACKUP"
  fileKey          String
  fileName         String
  fileSize         Int      // in bytes
  mimeType         String
  isPrivate        Boolean  @default(true)
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([schoolId, category])
}




