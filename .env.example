# Database Connection String (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# NextAuth Configuration
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-super-secret-key-in-production-min-32-chars"

# PII Encryption Key (AES-256-GCM for Aadhaar, Medical Data)
# Must be at least 32 characters long
PII_ENCRYPTION_KEY="school_erp_secure_pii_encryption_key_32chars!"

# Storage Configuration (local | s3)
# 'local' saves to public/uploads directory. Set 's3' for Cloudflare R2 / AWS S3.
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 Settings (Optional if STORAGE_PROVIDER="s3")
# AWS_S3_BUCKET="school-erp-uploads"
# AWS_S3_REGION="auto"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"

# Payment Gateway Configuration (Razorpay)
# For local dev/sandbox, mock fallback is automatically active if keys are omitted.
RAZORPAY_KEY_ID="rzp_test_school_erp_demo"
RAZORPAY_KEY_SECRET="rzp_secret_demo_key_12345"

# Multi-Channel Communications Gateway
# Fast2SMS (Indian SMS Gateway)
# FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# WhatsApp Cloud API (Meta Developers)
# WHATSAPP_API_TOKEN="your_meta_whatsapp_system_user_token"
# WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
