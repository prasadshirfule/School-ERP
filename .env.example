# ==============================================================================
# SCHOOL ERP — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env for local development and set values in Vercel/Hosting provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# Local: postgresql://postgres:postgres@localhost:5432/school_erp?schema=public
# Production: pooled transaction URL (e.g. Neon, Supabase, AWS RDS)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSIONS (NextAuth v4)
# ------------------------------------------------------------------------------
# Canonical base URL for NextAuth (Required in production, e.g. https://your-school.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Trust host header on Vercel deployments (Set to "true" on Vercel)
AUTH_TRUST_HOST="true"

# NextAuth session signing & JWT encryption secret (Must be at least 32 characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<GENERATE_SECURE_32_CHAR_BASE64_SECRET>"

# ------------------------------------------------------------------------------
# 3. PII ENCRYPTION AT REST (AES-256-GCM)
# ------------------------------------------------------------------------------
# 256-bit encryption key used for Aadhaar numbers and sensitive medical conditions.
# Must be at least 32 characters long. NEVER rotate without running migration script.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY="<GENERATE_SECURE_32_CHAR_BASE64_KEY>"

# ------------------------------------------------------------------------------
# 4. FILE STORAGE PROVIDER (local | s3)
# ------------------------------------------------------------------------------
# Local disk is intended for development only (saves to public/uploads).
# Production serverless deployments (Vercel) MUST use S3-compatible cloud storage (Cloudflare R2, AWS S3).
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 Credentials (Required when STORAGE_PROVIDER="s3")
# AWS_S3_BUCKET="<YOUR_S3_OR_R2_BUCKET_NAME>"
# AWS_S3_REGION="auto"
# AWS_ACCESS_KEY_ID="<YOUR_AWS_OR_R2_ACCESS_KEY_ID>"
# AWS_SECRET_ACCESS_KEY="<YOUR_AWS_OR_R2_SECRET_ACCESS_KEY>"
# AWS_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 5. ONLINE PAYMENTS (Razorpay)
# ------------------------------------------------------------------------------
# In development/test mode, omit or use test credentials.
# In production, live credentials are required. Mock signatures are strictly rejected.
RAZORPAY_KEY_ID="<YOUR_RAZORPAY_KEY_ID>"
RAZORPAY_KEY_SECRET="<YOUR_RAZORPAY_KEY_SECRET>"

# ------------------------------------------------------------------------------
# 6. MULTI-CHANNEL COMMUNICATIONS (Optional)
# ------------------------------------------------------------------------------
# Fast2SMS (Indian SMS Gateway)
# FAST2SMS_API_KEY="<YOUR_FAST2SMS_API_KEY>"

# WhatsApp Cloud API (Meta Developers)
# WHATSAPP_API_TOKEN="<YOUR_META_WHATSAPP_TOKEN>"
# WHATSAPP_PHONE_NUMBER_ID="<YOUR_WHATSAPP_PHONE_NUMBER_ID>"

# ------------------------------------------------------------------------------
# 7. DEVELOPMENT SEEDING OVERRIDE (Safety Guard)
# ------------------------------------------------------------------------------
# Only set on disposable dev databases if intentionally re-seeding demo records.
# ALWAYS keep unset or "false" on production databases!
# ALLOW_DESTRUCTIVE_SEED="false"
# RESET_DB="false"
