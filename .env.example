# ==============================================================================
# VIDYORA — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Product: Vidyora — Smarter Schools. Better Learning.
# Copy this file to .env.local for local development. Never commit secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string used at runtime by Prisma Client / Serverless compute
DATABASE_URL="postgresql://user:password@ep-staging-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled connection string used by Prisma Migrate and DDL operations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-staging.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth v4)
# ------------------------------------------------------------------------------
# Canonical base URL for NextAuth (http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Cryptographically random 32+ character hex string for signing JWT tokens and sessions
# Generate using: openssl rand -hex 32
NEXTAUTH_SECRET="your-32-byte-hex-secret-here"

# ------------------------------------------------------------------------------
# 3. APPLICATION SECURITY
# ------------------------------------------------------------------------------
# 256-bit AES-GCM hex encryption key used for sensitive PII encryption at rest
# Generate using: openssl rand -hex 32
PII_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"
