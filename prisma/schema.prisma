// ==============================================================================
// VIDYORA — PRISMA DATABASE SCHEMA
// Product: Vidyora — Smarter Schools. Better Learning.
// Database: PostgreSQL on Neon (Serverless)
// Tenant Architecture: Multi-tenant with row-level security & server-side scoping
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  PRINCIPAL
  ACCOUNTANT
  TEACHER
  PARENT
}

enum SchoolStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
}

enum StaffAttendanceStatus {
  PRESENT
  HALF_DAY
  LEAVE
  ABSENT
}

enum StaffLeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeeFrequency {
  ANNUAL
  TERM
  MONTHLY
  ONE_TIME
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum ExamLifecycleStatus {
  DRAFT
  SCHEDULED
  CONDUCTED
  EVALUATED
  APPROVED
  PUBLISHED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum RegistrationApplicationStatus {
  PENDING
  UNDER_REVIEW
  DOCUMENTS_REQUESTED
  APPROVED
  REJECTED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  MOBILE_OTP
  PASSWORD_RESET
  ADMIN_ACTIVATION
  PARENT_INVITATION
}

enum GuardianVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

// ------------------------------------------------------------------------------
// 1. CORE INSTITUTION & TENANT MODELS
// ------------------------------------------------------------------------------

model School {
  id                 String       @id @default(cuid())
  name               String
  boardType          String       @default("CBSE") // "CBSE" | "ICSE" | "STATE" | "IB" | "OTHER"
  address            String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  principalName      String?
  affiliationNumber  String?
  trustName          String?
  establishedYear    Int?
  status             SchoolStatus @default(ACTIVE)
  term1StartDate     DateTime?
  term1EndDate       DateTime?
  term2StartDate     DateTime?
  term2EndDate       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relational mappings
  memberships           SchoolMembership[]
  academicYears         AcademicYear[]
  classes               Class[]
  sections              Section[]
  subjects              Subject[]
  periods               Period[]
  students              Student[]
  teacherProfiles       TeacherProfile[]
  departments           Department[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]
  feePayments           FeePayment[]
  examTypes             ExamType[]
  examinations          Examination[]
  gradingScales         GradingScale[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  securityEvents        SecurityEvent[]
  studentAttendances    StudentAttendance[]
  staffAttendances      StaffAttendance[]
  staffLeaveRequests    StaffLeaveRequest[]
  timetableSlots        TimetableSlot[]
  transferCertificates  TransferCertificate[]
  studentReportCards    StudentReportCard[]
  admissionApplications AdmissionApplication[]
  studentDocuments      StudentDocument[]
  studentGuardians      StudentGuardian[]
  registrationApplication SchoolRegistrationApplication?

  @@index([status])
  @@index([createdAt])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String   // e.g. "2026-27"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructures        FeeStructure[]
  feeInvoices          FeeInvoice[]
  examTypes            ExamType[]
  examinations         Examination[]
  timetableSlots       TimetableSlot[]
  studentReportCards   StudentReportCard[]
  teacherAssignments   TeacherAssignment[]
  studentAttendances   StudentAttendance[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           Role
  isActive       Boolean   @default(true)
  suspendedAt    DateTime?
  suspendedReason String?
  sessionVersion Int       @default(1) // Incremented for instant token revocation
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    SchoolMembership[]
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([email])
  @@index([role, isActive])
}

model SchoolMembership {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  isPrimary Boolean   @default(true)
  isActive  Boolean   @default(true)
  revokedAt DateTime?
  joinedAt  DateTime  @default(now())

  @@unique([schoolId, userId])
  @@index([schoolId, role])
  @@index([schoolId, isActive])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// 2. ACADEMIC ARCHITECTURE
// ------------------------------------------------------------------------------

model Class {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String    // e.g. "Class 1", "Class 10"
  order     Int       // Numeric sort key (1, 2, ... 12)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  feeStructures FeeStructure[]
  examinations  Examination[]

  @@unique([schoolId, name])
  @@index([schoolId, order])
}

model Section {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String    // e.g. "A", "B", "Rose"
  capacity       Int       @default(40)
  classTeacherId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  students           Student[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  studentAttendances StudentAttendance[]

  @@unique([classId, name])
  @@index([schoolId, classId])
}

model Subject {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Mathematics", "Science"
  code       String   // e.g. "MATH", "SCI"
  isElective Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  examSubjects       ExamSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ClassSubject {
  id            String   @id @default(cuid())
  schoolId      String
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weeklyPeriods Int      @default(5)
  createdAt     DateTime @default(now())

  @@unique([classId, subjectId])
  @@index([schoolId, classId])
}

model Period {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodNumber Int      // 1, 2, 3...
  label        String   // "Period 1", "Morning Assembly", "Lunch Break"
  startTime    String   // "08:30"
  endTime      String   // "09:15"
  isBreak      Boolean  @default(false)
  createdAt    DateTime @default(now())

  timetableSlots TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
}

model TimetableSlot {
  id               String          @id @default(cuid())
  schoolId         String
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek        String          // "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT"
  periodId         String
  period           Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherProfileId String?
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@unique([sectionId, dayOfWeek, periodId, academicYearId])
  @@index([schoolId, sectionId, dayOfWeek])
  @@index([schoolId, teacherProfileId, dayOfWeek])
}

// ------------------------------------------------------------------------------
// 3. STAFF & TEACHER PROFILES
// ------------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String   // "Mathematics", "Science", "Humanities"
  code      String   // "MATH", "SCI", "HUM"
  createdAt DateTime @default(now())

  teacherProfiles TeacherProfile[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model TeacherProfile {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String      // School assigned staff code, e.g. "EMP-042"
  designation  String?     // "Senior Teacher", "TGT Mathematics"
  qualification String?
  joiningDate  DateTime?   @db.Date
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignments      TeacherAssignment[]
  staffAttendances StaffAttendance[]
  leaveRequests    StaffLeaveRequest[]
  timetableSlots   TimetableSlot[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
}

model TeacherAssignment {
  id               String         @id @default(cuid())
  schoolId         String
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, sectionId, subjectId, academicYearId])
  @@index([schoolId, sectionId])
  @@index([schoolId, teacherProfileId])
}

model StaffAttendance {
  id               String                @id @default(cuid())
  schoolId         String
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile   TeacherProfile        @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  date             DateTime              @db.Date
  status           StaffAttendanceStatus @default(PRESENT)
  checkInTime      DateTime?
  checkOutTime     DateTime?
  markedByUserId   String
  remarks          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([teacherProfileId, date])
  @@index([schoolId, date])
}

model StaffLeaveRequest {
  id               String         @id @default(cuid())
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  leaveType        StaffLeaveType @default(CASUAL)
  startDate        DateTime       @db.Date
  endDate          DateTime       @db.Date
  reason           String
  status           LeaveStatus    @default(PENDING)
  adminRemark      String?
  approvedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, teacherProfileId])
}

// ------------------------------------------------------------------------------
// 4. STUDENT & PARENT / GUARDIAN PROFILES
// ------------------------------------------------------------------------------

model Student {
  id                    String        @id @default(cuid())
  schoolId              String
  school                School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo           String        // Unique per school
  admissionDate         DateTime      @db.Date
  fullName              String
  rollNumber            String?
  dob                   DateTime?     @db.Date
  gender                Gender        @default(OTHER)
  bloodGroup            String?
  photoUrl              String?
  currentAddress        String?
  permanentAddress      String?
  emergencyContactPhone String?
  parentEmail           String?
  sectionId             String?
  section               Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  status                StudentStatus @default(ACTIVE)
  previousSchoolName    String?
  previousSchoolClass   String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  guardians            StudentGuardian[]
  attendances          StudentAttendance[]
  feeInvoices          FeeInvoice[]
  studentMarks         StudentMark[]
  reportCards          StudentReportCard[]
  documents            StudentDocument[]
  transferCertificates TransferCertificate[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, sectionId])
  @@index([schoolId, fullName])
}

model ParentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  email      String?
  phone      String
  occupation String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guardians StudentGuardian[]

  @@index([phone])
}

model StudentGuardian {
  id                 String               @id @default(cuid())
  schoolId           String
  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentProfileId    String
  parentProfile      ParentProfile        @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  relationship       GuardianRelationship       @default(FATHER)
  verificationStatus GuardianVerificationStatus @default(VERIFIED)
  isPrimary          Boolean                    @default(false)
  isAuthorizedPickup Boolean                    @default(true)
  createdAt          DateTime                   @default(now())

  @@unique([studentId, parentProfileId])
  @@index([schoolId, studentId])
  @@index([schoolId, parentProfileId])
  @@index([schoolId, verificationStatus])
}

model StudentAttendance {
  id                  String                  @id @default(cuid())
  schoolId            String
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId           String
  section             Section                 @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId      String
  academicYear        AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  date                DateTime                @db.Date
  status              StudentAttendanceStatus @default(PRESENT) // strictly PRESENT or ABSENT
  markedByUserId      String
  correctedByUserId   String?
  correctionReason    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([studentId, date, sectionId, academicYearId])
  @@index([schoolId, sectionId, date])
  @@index([schoolId, studentId, date])
}

model StudentDocument {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title              String
  docType            String   // "BIRTH_CERTIFICATE", "TRANSFER_CERTIFICATE", "MARKSHEET", "OTHER"
  fileUrl            String
  fileKey            String
  verificationStatus String   @default("PENDING") // "PENDING", "VERIFIED", "REJECTED"
  verifiedAt         DateTime?
  verifiedByUserId   String?
  createdAt          DateTime @default(now())

  @@index([schoolId, studentId])
}

model TransferCertificate {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tcNumber           String   // e.g. "TC-2026-001"
  issueDate          DateTime @db.Date
  reasonForLeaving   String
  lastAttendanceDate DateTime @db.Date
  conductRemark      String   @default("Good")
  generatedByUserId  String
  createdAt          DateTime @default(now())

  @@unique([schoolId, tcNumber])
  @@index([schoolId, studentId])
}

model AdmissionApplication {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationNo    String
  applicantName    String
  appliedClass     String
  parentName       String
  parentPhone      String
  parentEmail      String?
  status           String   @default("SUBMITTED") // "SUBMITTED", "UNDER_REVIEW", "ACCEPTED", "REJECTED"
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
}

// ------------------------------------------------------------------------------
// 5. FEES & FINANCIAL LEDGER (Offline Collection Only)
// ------------------------------------------------------------------------------

model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String?
  class          Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  name           String       // e.g. "Annual Tuition Fee 2026-27"
  totalAmount    Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency @default(ANNUAL)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  installments FeeInstallment[]
  invoices     FeeInvoice[]

  @@index([schoolId, academicYearId])
}

model FeeInstallment {
  id                String       @id @default(cuid())
  schoolId          String
  feeStructureId    String
  feeStructure      FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  installmentNumber Int
  name              String       // "Term 1 Installment"
  amount            Decimal      @db.Decimal(10, 2)
  dueDate           DateTime     @db.Date
  createdAt         DateTime     @default(now())

  @@unique([feeStructureId, installmentNumber])
  @@index([schoolId, dueDate])
}

model FeeInvoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoiceNumber  String        // e.g. "INV-2026-0001"
  totalAmountDue Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  netAmountDue   Decimal       @db.Decimal(10, 2)
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(UNPAID)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments  FeePayment[]
  discounts FeeDiscount[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, status])
  @@index([schoolId, dueDate])
}

model FeeDiscount {
  id               String     @id @default(cuid())
  schoolId         String
  invoiceId        String
  invoice          FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountType     String     // "MERIT", "SIBLING", "STAFF_CHILD", "EWS", "SPECIAL"
  amount           Decimal    @db.Decimal(10, 2)
  reason           String
  approvedByUserId String
  createdAt        DateTime   @default(now())

  @@index([schoolId, invoiceId])
}

model FeePayment {
  id                   String        @id @default(cuid())
  schoolId             String
  school               School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId            String
  invoice              FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNumber        String        // e.g. "REC-2026-0001"
  amount               Decimal       @db.Decimal(10, 2)
  paymentDate          DateTime      @default(now())
  paymentMethod        PaymentMethod @default(CASH) // CASH | UPI | BANK_TRANSFER (Offline only)
  transactionReference String?       // Bank / UTR reference for UPI/NEFT
  receivedByUserId     String
  remarks              String?
  isReversed           Boolean       @default(false)
  reversedAt           DateTime?
  reversalReason       String?
  reversedByUserId     String?
  createdAt            DateTime      @default(now())

  reversals PaymentReversal[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentDate])
}

model PaymentReversal {
  id                    String     @id @default(cuid())
  schoolId              String
  paymentId             String
  payment               FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  originalReceiptNumber String
  reversalAmount        Decimal    @db.Decimal(10, 2)
  reason                String
  authorizedByUserId    String
  createdAt             DateTime   @default(now())

  @@index([schoolId, paymentId])
}

// ------------------------------------------------------------------------------
// 6. EXAMINATIONS, MARKS & REPORT CARDS
// ------------------------------------------------------------------------------

model ExamType {
  id                  String       @id @default(cuid())
  schoolId            String
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  code                String       // "UT1", "UT2", "TERM1", "UT3", "UT4", "TERM2", "ANNUAL"
  name                String       // "Unit Test 1", "Term 1 Examination"
  weightagePercentage Decimal      @default(100) @db.Decimal(5, 2)
  order               Int          // 1, 2, 3...
  createdAt           DateTime     @default(now())

  examinations Examination[]

  @@unique([schoolId, academicYearId, code])
  @@index([schoolId, academicYearId, order])
}

model Examination {
  id             String              @id @default(cuid())
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examTypeId     String
  examType       ExamType            @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  classId        String
  class          Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  status         ExamLifecycleStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  examSubjects ExamSubject[]
  reportCards  StudentReportCard[]

  @@index([schoolId, academicYearId, classId])
}

model ExamSubject {
  id            String      @id @default(cuid())
  schoolId      String
  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examDate      DateTime    @db.Date
  maxMarks      Decimal     @db.Decimal(5, 2) // e.g. 100.00 or 50.00
  passMarks     Decimal     @db.Decimal(5, 2) // e.g. 33.00
  createdAt     DateTime    @default(now())

  studentMarks StudentMark[]

  @@unique([examinationId, subjectId])
  @@index([schoolId, examinationId])
}

model StudentMark {
  id            String      @id @default(cuid())
  schoolId      String
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Decimal?    @db.Decimal(5, 2)
  isAbsent      Boolean     @default(false)
  remarks       String?
  enteredByUserId String
  evaluatedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examSubjectId, studentId])
  @@index([schoolId, examSubjectId])
  @@index([schoolId, studentId])
}

model GradingScale {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   // "A1", "A2", "B1"
  minPercentage Decimal  @db.Decimal(5, 2)
  maxPercentage Decimal  @db.Decimal(5, 2)
  grade         String   // "A1", "A2", "B1", "B2", "C1", "C2", "D", "E"
  gradePoint    Decimal? @db.Decimal(3, 1) // e.g. 10.0, 9.0
  remarks       String?  // "Outstanding", "Excellent"
  createdAt     DateTime @default(now())

  @@unique([schoolId, grade])
  @@index([schoolId, minPercentage, maxPercentage])
}

model StudentReportCard {
  id                   String       @id @default(cuid())
  schoolId             String
  school               School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId       String
  academicYear         AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examinationId        String?
  examination          Examination? @relation(fields: [examinationId], references: [id], onDelete: SetNull)
  totalMarksObtained   Decimal      @db.Decimal(7, 2)
  totalMaxMarks        Decimal      @db.Decimal(7, 2)
  percentage           Decimal      @db.Decimal(5, 2) // Calculated as: (totalMarksObtained / totalMaxMarks) * 100
  overallGrade         String?
  rankInClass          Int?
  attendancePercentage Decimal?     @db.Decimal(5, 2)
  teacherRemarks       String?
  principalRemarks     String?
  isPublished          Boolean      @default(false)
  publishedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([studentId, academicYearId, examinationId])
  @@index([schoolId, academicYearId, studentId])
}

// ------------------------------------------------------------------------------
// 7. AUDIT TRAIL, NOTIFICATIONS & SECURITY EVENTS
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // "STUDENT_ADMITTED", "FEE_PAYMENT_COLLECTED", "MARKS_ENTERED"
  entityType String   // "Student", "FeePayment", "StudentMark"
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, action])
  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
}

model Notification {
  id        String              @id @default(cuid())
  schoolId  String
  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([schoolId, userId, isRead])
  @@index([schoolId, createdAt])
}

model SecurityEvent {
  id        String                @id @default(cuid())
  schoolId  String?
  school    School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  userId    String?
  eventType String                // "LOGIN_FAILED", "MFA_CHALLENGE_FAILED", "TENANT_BREACH_ATTEMPT"
  severity  SecurityEventSeverity @default(INFO)
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime              @default(now())

  @@index([schoolId, eventType])
  @@index([createdAt, severity])
}

// ------------------------------------------------------------------------------
// 8. REGISTRATION, VERIFICATION TOKENS & SECURITY RATE LIMITING
// ------------------------------------------------------------------------------

model SchoolRegistrationApplication {
  id                 String                        @id @default(cuid())
  schoolName         String
  schoolEmail        String                        @unique
  contactMobile      String
  address            String
  city               String
  state              String
  pincode            String
  boardType          String                        @default("CBSE")
  affiliationNumber  String?
  adminFullName      String
  adminEmail         String                        @unique
  adminMobile        String
  adminPasswordHash  String
  status             RegistrationApplicationStatus @default(PENDING)
  emailVerifiedAt    DateTime?
  mobileVerifiedAt   DateTime?
  reviewedBy         String?
  reviewNotes        String?
  rejectionReason    String?
  requestedDocuments String?
  submittedDocuments Json?
  createdSchoolId    String?                       @unique
  createdSchool      School?                       @relation(fields: [createdSchoolId], references: [id], onDelete: SetNull)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([status])
  @@index([schoolEmail])
  @@index([adminEmail])
}

model VerificationToken {
  id          String              @id @default(cuid())
  identifier  String              // email, mobile, or account reference
  tokenHash   String              // SHA-256 hash of token or 6-digit OTP
  purpose     VerificationPurpose
  expiresAt   DateTime
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)
  resendAfter DateTime?
  usedAt      DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([identifier, purpose])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RateLimitBucket {
  key        String   @id // e.g. "login:ip:1.2.3.4", "otp:mobile:+919876543210"
  count      Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

